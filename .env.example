# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ (architecture.md AD-9).
SUPABASE_SERVICE_ROLE_KEY=

# The site's own address, used for password-reset links and the printed table
# QR codes. Optional: on Vercel it is worked out from VERCEL_PROJECT_PRODUCTION_URL,
# and locally it falls back to http://localhost:3000. Set it only for a custom
# domain, which must override both.
NEXT_PUBLIC_SITE_URL=

# Needed from story 8.4 (the contact form) onward.
RESEND_API_KEY=
SUPPORT_INBOX=
